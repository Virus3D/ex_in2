<details class="card mb-3">
    <summary class="card-header">
        <i class="fas fa-chart-line me-2"></i>
        {{ 'chart.income.title'|trans }}
        <small class="text-muted">
            ({{ this.getFormattedTotalReceipts() }} ₽)
        </small>
    </summary>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6"
                 data-controller="chart"
                 data-chart-type-value="pie"
                 data-chart-data-value="{{ this.getCommentData()|json_encode }}"
                 data-chart-currency-value="₽">
                <h6 class="text-center mb-3">{{ 'chart.income.by_comments'|trans }}</h6>
                <div class="chartBlock">
                    <canvas data-chart-target="chart"></canvas>
                </div>
                <div class="customLegend" data-chart-target="legend"></div>
            </div>
            <div class="col-md-6"
                 data-controller="chart"
                 data-chart-type-value="line"
                 data-chart-data-value="{{ this.getDailyData()|json_encode }}"
                 data-chart-currency-value="₽">
                <h6 class="text-center mb-3">{{ 'chart.income.by_days'|trans }}</h6>
                <div class="chartBlock">
                    <canvas data-chart-target="chart"></canvas>
                </div>
            </div>
        </div>
    </div>
</details>