<div class="alert alert-success mb-0" {{ attributes }} data-loading="addClass(opacity-50) addAttribute(disabled)">
    {{ form_start(form, {
        attr: {
            class: 'form-horizontal',
            'data-model': 'norender|*',
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}
        <div class="input-group">
            <span class="input-group-text" style="width:125px">{{ 'header.receipt'|trans }}</span>
            {{ form_widget(form.card, {attr: {class: 'form-select'}}) }}
            {{ form_widget(form.date) }}
            {{ form_widget(form.balance, {attr: {placeholder: '0.00'}}) }}
            {{ form_widget(form.comment) }}
            <button type="submit" class="btn btn-primary">{{ 'action.add'|trans }}</button>
        </div>
        <datalist id="receipt-comment-options">
            {% for comment in this.getExistingComments() %}
                <option value="{{ comment }}">
            {% endfor %}
        </datalist>
        <div class="text-danger">
            {{ form_errors(form) }}
        </div>
    {{ form_end(form) }}
</div>
